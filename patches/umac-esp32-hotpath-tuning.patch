@@ -154,4 +154,14 @@ extern int overlay;
 #define ROM_RD_ALIGNED_BE16(addr)       READ_WORD_AL(_rom_base, addr)
 #define ROM_RD32(addr)                  READ_LONG(_rom_base, addr)
 
+// Emulator loop quantum and derived cycle count.
+// Override via build flags or the outer project's machw.h; default = 5000 µs.
+// Larger values reduce loop overhead but make mouse/kbd less responsive.
+#ifndef UMAC_EXECLOOP_QUANTUM
+#define UMAC_EXECLOOP_QUANTUM  5000
+#endif
+#ifndef UMAC_CYCLES_PER_QUANTUM
+#define UMAC_CYCLES_PER_QUANTUM (UMAC_EXECLOOP_QUANTUM * 8)
+#endif
+
 #endif
